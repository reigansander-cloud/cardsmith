# Copy this file to .env.local for running on your computer (npm run dev).
# For the live site, put the same two values in GitHub:
#   repo Settings -> Secrets and variables -> Actions -> Variables tab.
# Both come from Supabase: Project Settings -> API (the "anon"/"publishable"
# key is meant to be public; never put the service_role/secret key here).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
