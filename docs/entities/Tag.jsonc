{
  "name": "Tag",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Tag label"
    },
    "tab": {
      "type": "string",
      "description": "Database tab this tag belongs to",
      "default": "General"
    },
    "color": {
      "type": "string",
      "description": "Hex color used for the tag badge accent",
      "default": "#6b7280"
    },
    "icon": {
      "type": "string",
      "description": "URL of an optional icon image displayed on the tag badge"
    }
  },
  "required": [
    "name",
    "tab"
  ]
}